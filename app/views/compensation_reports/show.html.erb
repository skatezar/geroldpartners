<style>
  .report-show {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
    padding: 100px 20px;
  }

  .report-show-card {
    background: white;
    border-radius: 12px;
    box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    padding: 60px;
    max-width: 540px;
    width: 100%;
    text-align: center;
  }

  .report-show-icon {
    width: 64px;
    height: 64px;
    margin: 0 auto 24px;
    color: #000;
  }

  .report-show-icon svg {
    width: 100%;
    height: 100%;
  }

  .report-show-card h1 {
    font-size: 1.8rem;
    margin-bottom: 10px;
    color: #000;
  }

  .report-show-location {
    color: #666;
    font-size: 1rem;
    margin-bottom: 36px;
  }

  /* reuse modal styles from home page */
  .modal {
    display: none;
    position: fixed;
    z-index: 1000;
    left: 0; top: 0;
    width: 100%; height: 100%;
    background: rgba(0,0,0,0.5);
    align-items: center;
    justify-content: center;
  }

  .modal.show { display: flex; }

  .modal-content {
    background: white;
    border-radius: 12px;
    padding: 40px;
    max-width: 480px;
    width: 90%;
    position: relative;
  }

  .modal-content h2 {
    font-size: 1.6rem;
    margin-bottom: 8px;
    text-align: center;
  }

  .modal-close {
    position: absolute;
    top: 16px; right: 20px;
    font-size: 1.5rem;
    cursor: pointer;
    color: #666;
  }

  .modal-close:hover { color: #000; }

  .form-group {
    margin-bottom: 20px;
    text-align: left;
  }

  .form-group label {
    display: block;
    font-weight: 600;
    margin-bottom: 6px;
    font-size: 0.9rem;
  }

  .modal-input {
    width: 100%;
    padding: 10px 14px;
    border: 1px solid #ddd;
    border-radius: 6px;
    font-size: 1rem;
    box-sizing: border-box;
  }

  .modal-input:focus {
    outline: none;
    border-color: #000;
  }

  .modal-footer {
    margin-top: 24px;
    text-align: center;
  }

  .btn-primary {
    background: #000;
    color: #fff;
    border: none;
    padding: 12px 32px;
    border-radius: 6px;
    font-size: 1rem;
    cursor: pointer;
    width: 100%;
  }

  .btn-primary:hover { background: #333; }
  .btn-primary:disabled { background: #999; cursor: not-allowed; }
</style>

<section class="report-show">
  <div class="report-show-card">
    <div class="report-show-icon">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
      </svg>
    </div>

    <h1><%= @report.name %></h1>
    <p class="report-show-location"><%= @report.location %></p>

    <% if @report.pdf.attached? %>
      <button class="btn-primary" id="openDownloadModal"
              data-report-id="<%= @report.id %>"
              data-download-url="<%= rails_blob_path(@report.pdf, disposition: "attachment") %>">
        Download Report
      </button>
    <% else %>
      <p style="color:#999;">This report is not yet available.</p>
    <% end %>
  </div>
</section>

<div id="downloadModal" class="modal">
  <div class="modal-content">
    <span class="modal-close" id="downloadModalClose">&times;</span>
    <h2>Download Report</h2>
    <p style="text-align:center;color:#666;margin-bottom:20px;font-size:0.9rem;">Please provide your details to download this report</p>

    <input type="hidden" id="downloadReportId">
    <input type="hidden" id="downloadUrl">

    <div class="form-group">
      <label for="downloadName">Full Name</label>
      <input type="text" id="downloadName" class="modal-input" required placeholder="Jane Smith">
    </div>

    <div class="form-group">
      <label for="downloadEmail">Email</label>
      <input type="email" id="downloadEmail" class="modal-input" required placeholder="jane@company.com">
    </div>

    <div class="form-group">
      <label for="downloadCompDetails">Your Compensation (optional)</label>
      <p style="font-size:0.82rem;color:#888;margin:2px 0 8px;">Share your current comp — role, base, bonus, equity — and we'll add it to our dataset. We may follow up to verify and can share anonymised benchmarks in return.</p>
      <textarea id="downloadCompDetails" class="modal-input" rows="3" placeholder="e.g. CFO, €180k base + 20% bonus, Series B SaaS"></textarea>
    </div>

    <div class="modal-footer">
      <button class="btn-primary" id="downloadSubmitBtn">Download</button>
    </div>
  </div>
</div>

<script>
  const modal = document.getElementById('downloadModal');
  const openBtn = document.getElementById('openDownloadModal');
  const closeBtn = document.getElementById('downloadModalClose');
  const submitBtn = document.getElementById('downloadSubmitBtn');

  if (openBtn) {
    openBtn.addEventListener('click', () => {
      document.getElementById('downloadReportId').value = openBtn.dataset.reportId;
      document.getElementById('downloadUrl').value = openBtn.dataset.downloadUrl;
      modal.classList.add('show');
      document.body.style.overflow = 'hidden';
    });
  }

  closeBtn.addEventListener('click', closeModal);
  window.addEventListener('click', e => { if (e.target === modal) closeModal(); });

  function closeModal() {
    modal.classList.remove('show');
    document.body.style.overflow = 'auto';
  }

  submitBtn.addEventListener('click', async () => {
    const name = document.getElementById('downloadName').value.trim();
    const email = document.getElementById('downloadEmail').value.trim();
    const compensationDetails = document.getElementById('downloadCompDetails').value.trim();
    const reportId = document.getElementById('downloadReportId').value;
    const downloadUrl = document.getElementById('downloadUrl').value;

    if (!name || !email) {
      alert('Please fill in your name and email.');
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = 'Downloading...';

    const csrfToken = document.querySelector('meta[name="csrf-token"]').getAttribute('content');

    try {
      const response = await fetch('/compensation_reports/download', {
        method: 'POST',
        headers: {
          'X-CSRF-Token': csrfToken,
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({ report_id: reportId, name, email, compensation_details: compensationDetails })
      });

      const result = await response.json();

      if (result.success) {
        window.open(downloadUrl, '_blank');
        closeModal();
      } else {
        alert('Error: ' + (result.errors ? result.errors.join(', ') : 'Something went wrong'));
      }
    } catch {
      alert('Error submitting form. Please try again.');
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Download';
    }
  });
</script>
