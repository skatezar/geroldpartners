<nav class="side-nav">
  <div class="nav-logo">GP</div>
  <ul class="nav-links">
    <li><a href="/" class="nav-link">
      <span class="nav-dot"></span>
      <span class="nav-text">Home</span>
    </a></li>
    <li><a href="/#compensation-reports" class="nav-link active">
      <span class="nav-dot"></span>
      <span class="nav-text">Reports</span>
    </a></li>
  </ul>
</nav>

<!-- Top header -->
<header class="report-show-header">
  <a href="/" class="report-show-back">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="vertical-align:middle;margin-right:6px;">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
    </svg>
    Back
  </a>
  <span class="report-show-header-title">Gerold &amp; Partners</span>
</header>

<!-- Main content -->
<div class="report-show-page">
  <div class="report-show-card">
    <div class="report-show-icon">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
      </svg>
    </div>

    <h1><%= @report.name %></h1>
    <p class="report-show-location"><%= @report.location %></p>

    <% if @report.pdf.attached? %>
      <button class="btn-primary" id="openDownloadModal"
              data-report-id="<%= @report.id %>"
              data-download-url="<%= rails_blob_path(@report.pdf, disposition: "attachment") %>">
        Download Report
      </button>
    <% else %>
      <p style="color:#999;margin-top:10px;">This report is not yet available.</p>
    <% end %>

    <a href="https://wa.me/447456252602" target="_blank" class="whatsapp-link">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
      Ping us on WhatsApp
    </a>
    <p style="margin-top:8px;font-size:0.82rem;color:#999;">To discuss your market-level compensation data in more detail</p>
  </div>
</div>

<!-- Download Modal -->
<div id="downloadModal" class="modal">
  <div class="modal-content">
    <span class="modal-close" id="downloadModalClose">&times;</span>
    <h2>Download Report</h2>
    <p style="text-align:center;color:#666;margin-bottom:20px;font-size:0.9rem;">Enter your details and we'll send the report to your email</p>

    <div style="position:absolute;left:-9999px;opacity:0;"><input type="text" id="hp_website_url" tabindex="-1" autocomplete="off"></div>
    <input type="hidden" id="downloadReportId">
    <input type="hidden" id="downloadUrl">

    <div class="form-group">
      <label for="downloadName">Full Name</label>
      <input type="text" id="downloadName" class="modal-input" required placeholder="Jane Smith">
    </div>

    <div class="form-group">
      <label for="downloadEmail">Email</label>
      <input type="email" id="downloadEmail" class="modal-input" required placeholder="jane@company.com">
    </div>

    <div class="form-group">
      <label for="downloadCompDetails">Compensation Details (Optional)</label>
      <p style="font-size:0.82rem;color:#888;margin:2px 0 8px;">Share your current comp — role, base, bonus, equity. Helps us improve our benchmarks.</p>
      <textarea id="downloadCompDetails" class="modal-input" rows="3" placeholder="e.g. CFO, €180k base + 20% bonus, Series B SaaS"></textarea>
    </div>

    <div class="form-group" style="display:flex;align-items:flex-start;gap:10px;">
      <input type="checkbox" id="downloadNewsletter" style="margin-top:3px;flex-shrink:0;width:16px;height:16px;cursor:pointer;">
      <label for="downloadNewsletter" style="font-weight:normal;font-size:0.95rem;cursor:pointer;margin:0;">Join our newsletter for executive insights and market updates</label>
    </div>

    <div class="modal-footer">
      <button class="btn-primary modal-submit" id="downloadSubmitBtn">Send to my email</button>
      <a href="https://wa.me/447456252602" target="_blank" class="whatsapp-link">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        Ping us on WhatsApp
      </a>
      <p style="margin-top:8px;font-size:0.82rem;color:#999;text-align:center;">To discuss your market-level compensation data in more detail</p>
    </div>
  </div>
</div>

<style>
  .report-show-header {
    position: fixed;
    top: 0;
    left: 255px;
    right: 0;
    height: 60px;
    background: white;
    border-bottom: 1px solid #eee;
    display: flex;
    align-items: center;
    padding: 0 30px;
    z-index: 500;
    justify-content: space-between;
  }

  .report-show-back {
    color: #333;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.3px;
    transition: color 0.2s;
  }

  .report-show-back:hover { color: #000; }

  .report-show-header-title {
    font-size: 0.9rem;
    color: #999;
    letter-spacing: 0.5px;
  }

  .report-show-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
    padding: 100px 20px 60px;
  }

  .report-show-card {
    background: white;
    border-radius: 12px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
    padding: 60px;
    max-width: 540px;
    width: 100%;
    text-align: center;
  }

  .report-show-icon {
    width: 64px;
    height: 64px;
    margin: 0 auto 24px;
    color: #000;
  }

  .report-show-icon svg {
    width: 100%;
    height: 100%;
  }

  .report-show-card h1 {
    font-size: 1.8rem;
    margin-bottom: 10px;
    color: #000;
  }

  .report-show-location {
    color: #666;
    font-size: 1rem;
    margin-bottom: 36px;
  }

  @media (max-width: 768px) {
    .report-show-header {
      left: 0;
    }
    .report-show-card {
      padding: 40px 24px;
    }
  }
</style>

<script>
  const modal = document.getElementById('downloadModal');
  const openBtn = document.getElementById('openDownloadModal');
  const closeBtn = document.getElementById('downloadModalClose');
  const submitBtn = document.getElementById('downloadSubmitBtn');

  if (openBtn) {
    openBtn.addEventListener('click', () => {
      document.getElementById('downloadReportId').value = openBtn.dataset.reportId;
      document.getElementById('downloadUrl').value = openBtn.dataset.downloadUrl;
      modal.classList.add('show');
      document.body.style.overflow = 'hidden';
    });
  }

  closeBtn.addEventListener('click', closeModal);
  window.addEventListener('click', e => { if (e.target === modal) closeModal(); });

  function closeModal() {
    modal.classList.remove('show');
    document.body.style.overflow = 'auto';
  }

  submitBtn.addEventListener('click', async () => {
    const name = document.getElementById('downloadName').value.trim();
    const email = document.getElementById('downloadEmail').value.trim();
    const compensationDetails = document.getElementById('downloadCompDetails').value.trim();
    const newsletter = document.getElementById('downloadNewsletter').checked;
    const reportId = document.getElementById('downloadReportId').value;
    const downloadUrl = document.getElementById('downloadUrl').value;

    if (!name || !email) {
      alert('Please fill in your name and email.');
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = 'Sending...';

    const csrfToken = document.querySelector('meta[name="csrf-token"]').getAttribute('content');

    try {
      const response = await fetch('/compensation_reports/download', {
        method: 'POST',
        headers: { 'X-CSRF-Token': csrfToken, 'Content-Type': 'application/json' },
        body: JSON.stringify({ report_id: reportId, name, email, compensation_details: compensationDetails, newsletter, website_url: document.getElementById('hp_website_url').value })
      });

      const result = await response.json();

      if (result.success) {
        const modalContent = document.querySelector('#downloadModal .modal-content');
        const originalContent = modalContent.innerHTML;
        modalContent.innerHTML = `
          <div style="text-align:center;padding:60px 40px;">
            <div style="width:64px;height:64px;background:#000;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 24px;">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="none" viewBox="0 0 24 24" stroke="white" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            </div>
            <h2 style="font-size:1.6rem;margin-bottom:12px;color:#000;">Report sent</h2>
            <p style="color:#666;font-size:1rem;">Check your inbox — the report is on its way.</p>
          </div>`;
        setTimeout(() => {
          closeModal();
          modalContent.innerHTML = originalContent;
        }, 2500);
      } else {
        alert('Error: ' + (result.errors ? result.errors.join(', ') : 'Something went wrong'));
      }
    } catch {
      alert('Error submitting form. Please try again.');
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Download';
    }
  });
</script>
