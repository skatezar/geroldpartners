<% content_for :title, "Thank you — Gerold & Partners" %>
<div class="done-wrap">
  <header class="done-header">
    <p class="kicker">Gerold &amp; Partners</p>
    <h1>Thank you, <%= @recommendation.name.to_s.split.first %>.</h1>
    <p class="lede">Your availability has been received. We'll be in touch shortly to confirm which slot works best with the client.</p>
  </header>
  <footer class="page-foot">
    <p>Gerold &amp; Partners &mdash; Executive Search</p>
  </footer>
</div>

<style>
  body { margin: 0; background: #fafafa; }
  .done-wrap { max-width: 620px; margin: 0 auto; padding: 100px 24px 80px; font-family: 'Garamond', serif; color: #1a1a1a; text-align: center; }
  .done-header { padding-bottom: 28px; border-bottom: 2px solid #000; margin-bottom: 40px; }
  .kicker { margin: 0 0 6px; text-transform: uppercase; letter-spacing: 2px; font-size: 0.8rem; color: #666; }
  .done-header h1 { margin: 0 0 14px; font-size: 2.6rem; line-height: 1.1; }
  .lede { margin: 0; font-size: 1.1rem; color: #555; line-height: 1.6; }
  .page-foot { margin-top: 60px; padding-top: 24px; border-top: 1px solid #ddd; color: #888; font-size: 0.88rem; }
</style>
