<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Analyst & Associate Compensation — Madrid, Spain 2026</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --black: #000;
  --dark: #111;
  --mid: #444;
  --light-mid: #888;
  --border: #e0e0e0;
  --bg: #f8f9fa;
  --white: #fff;
}

html { scroll-behavior: smooth; }

body {
  font-family: 'Inter', sans-serif;
  background: var(--white);
  color: var(--dark);
  font-size: 16px;
  line-height: 1.75;
}

/* ── SIDE NAV ── */
.side-nav {
  position: fixed;
  left: 0;
  top: 0;
  height: 100vh;
  width: 200px;
  background: var(--black);
  z-index: 100;
  display: flex;
  flex-direction: column;
  padding: 32px 0;
}

.nav-logo {
  font-family: 'Playfair Display', serif;
  font-size: 18px;
  font-weight: 700;
  color: var(--white);
  padding: 0 28px 32px;
  border-bottom: 1px solid #222;
  letter-spacing: 0.05em;
}

.nav-links {
  list-style: none;
  padding: 24px 0;
  flex: 1;
}

.nav-link {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px 28px;
  color: #999;
  text-decoration: none;
  font-size: 12px;
  font-weight: 500;
  letter-spacing: 0.04em;
  transition: color 0.2s;
  white-space: nowrap;
}

.nav-link:hover,
.nav-link.active { color: var(--white); }

.nav-dot {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: #444;
  flex-shrink: 0;
  transition: background 0.2s;
}

.nav-link:hover .nav-dot,
.nav-link.active .nav-dot { background: var(--white); }

.nav-contact {
  padding: 16px 20px;
  border-top: 1px solid #222;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.nav-contact-btn {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 7px 10px;
  color: #999;
  text-decoration: none;
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.04em;
  border: 1px solid #333;
  border-radius: 4px;
  transition: color 0.2s, border-color 0.2s;
}

.nav-contact-btn:hover { color: var(--white); border-color: #555; }

/* ── MAIN CONTENT ── */
.page-wrap { margin-left: 200px; }

/* ── HEADER ── */
header {
  background: var(--black);
  padding: 80px 64px 72px;
  position: relative;
}

.confidential-badge {
  position: absolute;
  top: 28px;
  right: 40px;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: #888;
  border: 1px solid #333;
  padding: 4px 10px;
}

.gp-tag {
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: #666;
  margin-bottom: 20px;
}

header h1 {
  font-family: 'Playfair Display', serif;
  font-size: clamp(28px, 3.2vw, 48px);
  font-weight: 700;
  color: var(--white);
  line-height: 1.15;
  max-width: 680px;
  margin-bottom: 20px;
}

header h1 em { font-style: italic; color: #bbb; }

.header-meta {
  font-size: 13px;
  color: #555;
  letter-spacing: 0.04em;
}

.header-meta span { margin: 0 8px; }

/* ── CONTENT ── */
.intro-section {
  padding: 64px 64px 0;
  max-width: 820px;
}

.lede {
  font-family: 'Playfair Display', serif;
  font-size: 21px;
  font-weight: 400;
  line-height: 1.6;
  color: var(--dark);
  border-left: 3px solid var(--black);
  padding-left: 24px;
  margin-bottom: 28px;
}

.intro-section p {
  color: var(--mid);
  margin-bottom: 16px;
  font-size: 15.5px;
}

.section-divider {
  border: none;
  border-top: 1px solid var(--border);
  margin: 0 64px;
}

.comp-section {
  padding: 56px 64px 0;
  max-width: 900px;
  scroll-margin-top: 24px;
}

.section-label {
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: #aaa;
  margin-bottom: 10px;
}

.comp-section h2 {
  font-family: 'Playfair Display', serif;
  font-size: 28px;
  font-weight: 700;
  color: var(--black);
  margin-bottom: 20px;
  line-height: 1.2;
}

.comp-section p {
  color: var(--mid);
  margin-bottom: 16px;
  font-size: 15.5px;
}

/* ── COMP TABLE ── */
.comp-table-wrap {
  margin: 0 0 28px;
  border: 1px solid var(--border);
  overflow: hidden;
}

.comp-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 14px;
}

.comp-table thead tr {
  background: var(--black);
  color: var(--white);
}

.comp-table thead th {
  padding: 12px 16px;
  text-align: left;
  font-weight: 500;
  font-size: 11px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.comp-table thead th:first-child { width: 38%; }

.comp-table tbody tr { border-bottom: 1px solid #f0f0f0; }
.comp-table tbody tr:last-child { border-bottom: none; }
.comp-table tbody tr:hover { background: #fafafa; }

.comp-table tbody td {
  padding: 13px 16px;
  color: var(--mid);
  vertical-align: middle;
}

.comp-table tbody td:first-child {
  color: var(--dark);
  font-weight: 500;
}

/* tier colouring */
.tier-bb    { background: #f0f0f0; }
.tier-elite { background: #e8e0f0; }

.total-col {
  font-weight: 600;
  color: var(--black) !important;
}

/* ── BAR CHART ── */
.bar-chart-wrap {
  margin: 0 0 28px;
  background: var(--bg);
  border: 1px solid var(--border);
  padding: 22px 24px 18px;
}

.chart-title {
  font-size: 10.5px;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: #bbb;
  margin-bottom: 18px;
}

.bar-row {
  display: flex;
  align-items: center;
  margin-bottom: 9px;
  gap: 10px;
}

.bar-label {
  font-size: 11.5px;
  color: #666;
  width: 210px;
  flex-shrink: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.bar-track {
  flex: 1;
  height: 18px;
  background: #ebebeb;
  border-radius: 2px;
  position: relative;
  overflow: visible;
}

.bar-fill {
  height: 100%;
  border-radius: 2px;
  position: absolute;
  left: 0;
  top: 0;
}

.bar-base  { background: #555; }
.bar-bonus { background: #bbb; }

.bar-value {
  font-size: 11px;
  font-weight: 600;
  color: var(--dark);
  width: 72px;
  flex-shrink: 0;
  text-align: right;
}

.bar-legend {
  display: flex;
  gap: 20px;
  margin-bottom: 14px;
  font-size: 11px;
  color: #999;
}

.bar-legend span {
  display: flex;
  align-items: center;
  gap: 6px;
}

.legend-dot {
  width: 10px;
  height: 10px;
  border-radius: 2px;
  flex-shrink: 0;
}

.chart-note {
  font-size: 10.5px;
  color: #c0c0c0;
  font-style: italic;
  margin-top: 8px;
}

/* ── CALLOUT ── */
.callout {
  background: var(--bg);
  border-left: 3px solid var(--black);
  border-radius: 2px;
  padding: 16px 20px;
  margin: 20px 0;
  font-size: 15px;
  color: var(--mid);
  line-height: 1.65;
}

.callout strong { color: var(--black); }

/* ── TOTAL SECTION ── */
.total-section {
  background: var(--black);
  margin-top: 72px;
  padding: 64px;
}

.total-section h2 {
  font-family: 'Playfair Display', serif;
  font-size: 28px;
  font-weight: 700;
  color: var(--white);
  margin-bottom: 32px;
}

.total-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0;
  border-top: 1px solid #222;
  border-left: 1px solid #222;
  margin-bottom: 32px;
}

.total-item {
  border-right: 1px solid #222;
  border-bottom: 1px solid #222;
  padding: 22px 26px;
}

.t-label {
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: #555;
  margin-bottom: 8px;
}

.t-value {
  font-size: 20px;
  font-weight: 600;
  color: var(--white);
  letter-spacing: -0.01em;
  margin-bottom: 4px;
}

.t-note { font-size: 11px; color: #555; }

.total-bottom {
  border-top: 1px solid #1a1a1a;
  padding-top: 20px;
  font-size: 13px;
  color: #555;
  line-height: 1.7;
  max-width: 700px;
}

/* ── FOOTER ── */
footer {
  background: var(--black);
  border-top: 1px solid #111;
  padding: 24px 64px;
  font-size: 12px;
  color: #444;
  letter-spacing: 0.06em;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

footer a { color: #666; text-decoration: none; }
footer a:hover { color: var(--white); }

/* ── RESPONSIVE ── */
@media (max-width: 900px) {
  .side-nav { display: none; }
  .page-wrap { margin-left: 0; padding-top: 52px; }

  header {
    padding: 48px 20px 40px;
  }

  header h1 {
    font-size: clamp(22px, 6vw, 34px);
    max-width: 100%;
  }

  .intro-section, .comp-section, .total-section {
    padding: 36px 20px 0;
  }

  .section-divider {
    margin: 0 20px;
  }

  .container {
    padding: 0 20px;
  }

  .total-grid { grid-template-columns: 1fr; }
  .bar-label { width: 120px; font-size: 10px; }

  .chart-wrap {
    padding: 16px 12px 12px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .bw-chart {
    min-width: 460px;
  }

  .comp-table {
    display: block;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    white-space: nowrap;
  }

  footer {
    padding: 20px 20px;
    flex-direction: column;
    gap: 8px;
    text-align: center;
  }
}

/* Mobile nav bar for blog */
.blog-mobile-nav {
  display: none;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 200;
  background: rgba(0,0,0,0.97);
  height: 52px;
  align-items: center;
  justify-content: space-between;
  padding: 0 20px;
  box-shadow: 0 2px 12px rgba(0,0,0,0.4);
}

.blog-mobile-nav-logo {
  font-family: 'Playfair Display', serif;
  font-size: 1rem;
  font-weight: 700;
  color: white;
  letter-spacing: 0.05em;
  text-decoration: none;
}

.blog-mobile-back {
  font-size: 12px;
  font-weight: 500;
  color: #999;
  text-decoration: none;
  letter-spacing: 0.04em;
  transition: color 0.2s;
}

.blog-mobile-back:hover { color: white; }

@media (max-width: 900px) {
  .blog-mobile-nav { display: flex; }
}
</style>
