<% content_for :title, @client.name %>
<div class="gate-wrap">
  <div class="gate-card">
    <h1><%= @client.name %></h1>
    <p class="subtitle">This is a private candidate brief. Please enter the access password provided by Gerold &amp; Partners.</p>

    <% if flash[:alert] %>
      <div class="error"><%= flash[:alert] %></div>
    <% end %>

    <%= form_with url: authenticate_client_path(@client.slug), method: :post, local: true, class: "gate-form" do |f| %>
      <%= f.label :password, "Password" %>
      <%= f.password_field :password, autofocus: true, required: true %>
      <%= f.submit "Access", class: "gate-btn" %>
    <% end %>
  </div>
</div>

<style>
  body { margin: 0; background: #fafafa; }
  .gate-wrap { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 20px; font-family: 'Garamond', serif; }
  .gate-card { background: white; padding: 50px 45px; border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); max-width: 460px; width: 100%; }
  .gate-card h1 { margin: 0 0 12px; font-size: 2.2rem; color: #000; }
  .subtitle { color: #555; line-height: 1.5; margin: 0 0 28px; }
  .gate-form label { display: block; margin-bottom: 8px; font-weight: 600; color: #333; }
  .gate-form input[type="password"] { width: 100%; padding: 14px 16px; border: 1px solid #ddd; border-radius: 8px; font-size: 1rem; font-family: 'Garamond', serif; box-sizing: border-box; margin-bottom: 20px; }
  .gate-form input[type="password"]:focus { outline: none; border-color: #000; }
  .gate-btn { width: 100%; padding: 14px; background: #000; color: white; border: none; border-radius: 8px; font-size: 1.05rem; cursor: pointer; font-family: 'Garamond', serif; }
  .gate-btn:hover { background: #333; }
  .error { background: #f8d7da; color: #721c24; padding: 12px 16px; border-radius: 6px; margin-bottom: 20px; }
</style>
