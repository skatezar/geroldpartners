<div style="min-height: 100vh; display: flex; align-items: center; justify-content: center; background: #fff; padding: 20px;">
  <div style="max-width: 600px; width: 100%; background: white; border: 1px solid #000;">
    <% if @already_confirmed %>
      <div style="background: #000; padding: 50px 40px; text-align: center; color: white; border-bottom: 1px solid #000;">
        <h1 style="margin: 0; font-size: 28px; font-weight: 300; letter-spacing: 2px; text-transform: uppercase;">Gerold & Partners</h1>
        <p style="margin: 15px 0 0; font-size: 13px; letter-spacing: 1px; opacity: 0.9; font-weight: 300;">Executive Search & Advisory</p>
      </div>
      <div style="padding: 50px 40px; background: #fff; text-align: center;">
        <div style="width: 60px; height: 60px; background: #000; color: white; font-size: 2rem; line-height: 60px; border-radius: 50%; margin: 0 auto 30px;">ℹ</div>
        <h2 style="color: #000; font-size: 24px; margin-bottom: 20px; font-weight: 300; letter-spacing: 1px;">Already Confirmed</h2>
        <p style="color: #666; font-size: 16px; margin-bottom: 30px; line-height: 1.8;">
          Your email has already been confirmed. You're all set to receive our newsletter updates.
        </p>
        <%= link_to "Return to Home", root_path, style: "display: inline-block; padding: 18px 50px; background: #000; color: white; text-decoration: none; font-size: 14px; font-weight: 500; letter-spacing: 1.5px; text-transform: uppercase; transition: all 0.3s ease;" %>
      </div>
    <% else %>
      <div style="background: #000; padding: 50px 40px; text-align: center; color: white; border-bottom: 1px solid #000;">
        <h1 style="margin: 0; font-size: 28px; font-weight: 300; letter-spacing: 2px; text-transform: uppercase;">Gerold & Partners</h1>
        <p style="margin: 15px 0 0; font-size: 13px; letter-spacing: 1px; opacity: 0.9; font-weight: 300;">Executive Search & Advisory</p>
      </div>
      <div style="padding: 50px 40px; background: #fff; text-align: center;">
        <div style="width: 60px; height: 60px; background: #000; color: white; font-size: 2rem; line-height: 60px; border-radius: 50%; margin: 0 auto 30px; animation: scaleIn 0.5s ease;">✓</div>
        <h2 style="color: #000; font-size: 24px; margin-bottom: 20px; font-weight: 300; letter-spacing: 1px;">Subscription Confirmed</h2>
        <p style="color: #666; font-size: 16px; margin-bottom: 30px; line-height: 1.8;">
          Thank you for confirming your subscription. You'll now receive updates on new opportunities and industry insights from Gerold & Partners.
        </p>
        <%= link_to "Return to Home", root_path, style: "display: inline-block; padding: 18px 50px; background: #000; color: white; text-decoration: none; font-size: 14px; font-weight: 500; letter-spacing: 1.5px; text-transform: uppercase; transition: all 0.3s ease;" %>
      </div>
    <% end %>
    <div style="background: #f8f9fa; padding: 40px; text-align: center; font-size: 13px; color: #666; border-top: 1px solid #e0e0e0; line-height: 1.8;">
      <p style="margin: 0;"><strong style="color: #000; font-weight: 500; letter-spacing: 0.5px;">Gerold & Partners</strong><br>
      Executive Search & Advisory</p>
      <p style="margin-top: 15px; margin-bottom: 0;">contact@geroldpartners.com</p>
    </div>
  </div>
</div>

<style>
  @keyframes scaleIn {
    from {
      transform: scale(0);
      opacity: 0;
    }
    to {
      transform: scale(1);
      opacity: 1;
    }
  }

  body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  }
</style>
