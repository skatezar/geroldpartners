<div style="font-family: Garamond, Georgia, serif; color: #1a1a1a; line-height: 1.6; max-width: 620px; margin: 0 auto; padding: 30px 24px;">
  <p>Hi,</p>

  <p>Please see below the availabilities for a first round interview with <strong><%= @recommendation.name %></strong>.</p>

  <div style="margin: 28px 0; padding: 20px 24px; background: #f8f8f8; border-left: 4px solid #000; border-radius: 4px;">
    <p style="margin: 0 0 12px; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 1px; color: #777; font-weight: 600;">
      Available slots<% if @client.timezone.present? %> &mdash; <%= @client.timezone %><% end %>
    </p>
    <% @slots.each_with_index do |slot, i| %>
      <p style="margin: 0 0 8px; font-size: 1.05rem;">
        <strong>Option <%= i + 1 %>:</strong> <%= slot %>
      </p>
    <% end %>
  </div>

  <p>Please feel free to send a calendar invite with a call link directly to <strong><%= @recommendation.name %></strong> (cc).</p>

  <p style="margin-top: 28px;">Best regards,<br>Laurenz Gerold<br>Gerold &amp; Partners</p>
</div>
