<!-- CV Upload Section -->
<section id="cv-upload" class="cv-upload section-animate">
  <div class="container">
    <div id="cvFormContent">
      <h2 style="color: black;">Join Our Network</h2>
      <p style="text-align: center;">Upload your CV to be considered for current and future opportunities</p>
      <%= form_with url: talent_pool_applications_path, multipart: true, id: "cvForm", class: "cv-form" do |f| %>
        <div class="form-group">
          <%= f.label :name, "Full Name" %>
          <%= f.text_field :name, required: true %>
        </div>
        <div class="form-group">
          <%= f.label :email, "Email" %>
          <%= f.email_field :email, required: true %>
        </div>
        <div class="form-group">
          <%= f.label :phone, "Phone (Optional)" %>
          <%= f.telephone_field :phone %>
        </div>
        <div class="form-group">
          <div class="cv-drop-zone" id="cvDropZone">
            <div class="drop-zone-content">
              <svg class="upload-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
              </svg>
              <p class="drop-zone-text">Drop your CV here</p>
              <p class="drop-zone-subtext">or click to browse (PDF only)</p>
              <p class="file-name" id="fileName"></p>
            </div>
            <%= f.file_field :cv, accept: ".pdf", required: true, id: "cvFileInput", style: "display: none;" %>
          </div>
        </div>
        <%= f.submit "Submit CV", class: "btn-primary", id: "cvSubmitBtn" %>
      <% end %>
    </div>

    <!-- Success Message -->
    <div id="cvSuccessMessage" style="display: none; text-align: center; padding: 60px 40px;">
      <div style="width: 80px; height: 80px; background: linear-gradient(135deg, #28a745 0%, #20c997 100%); color: white; font-size: 3rem; line-height: 80px; border-radius: 50%; margin: 0 auto 30px; animation: scaleIn 0.5s ease;">✓</div>
      <h2 style="color: #000; font-size: 2rem; margin-bottom: 20px;">Application Received!</h2>
      <p style="color: #666; font-size: 1.1rem; margin-bottom: 30px;">Thank you for joining our talent pool. We'll reach out if there's a suitable opportunity.</p>
    </div>
  </div>
</section>

<!-- Contact Form -->
<section id="contact" class="contact section-animate">
  <div class="container">
    <div id="contactFormContent">
      <h2>Get In Touch</h2>
      
      <%= form_with model: Contact.new, url: contacts_path, id: "contactForm", class: "contact-form" do |f| %>
        <!-- Honeypot field -->
        <div style="position: absolute; left: -9999px; opacity: 0;">
          <%= f.text_field :website, tabindex: "-1", autocomplete: "off" %>
        </div>

        <!-- Hidden timestamp -->
        <input type="hidden" name="form_timestamp" id="contactFormTimestamp">

        <div class="form-row">
          <div class="form-group">
            <%= f.label :name, "Name" %>
            <%= f.text_field :name, required: true %>
          </div>
          <div class="form-group">
            <%= f.label :email, "Email" %>
            <%= f.email_field :email, required: true %>
          </div>
        </div>
        <div class="form-group">
          <%= f.label :message, "Message" %>
          <%= f.text_area :message, rows: 6, required: true %>
        </div>

        <!-- Cloudflare Turnstile -->
        <div class="form-group" style="margin-top: 25px;">
          <div class="cf-turnstile"
               data-sitekey="<%= ENV['CLOUDFLARE_TURNSTILE_SITE_KEY'] %>"
               data-callback="onContactTurnstileSuccess"></div>
        </div>

        <%= f.submit "Send Message", class: "btn-primary", id: "contactSubmitBtn", disabled: true %>
      <% end %>
    </div>

    <!-- Success Message -->
    <div id="contactSuccessMessage" style="display: none; text-align: center; padding: 60px 40px;">
      <div style="width: 80px; height: 80px; background: linear-gradient(135deg, #28a745 0%, #20c997 100%); color: white; font-size: 3rem; line-height: 80px; border-radius: 50%; margin: 0 auto 30px; animation: scaleIn 0.5s ease;">✓</div>
      <h2 style="color: #000; font-size: 2rem; margin-bottom: 20px;">Message Sent!</h2>
      <p style="color: #666; font-size: 1.1rem; margin-bottom: 30px;">Thank you for reaching out. We'll get back to you soon.</p>
    </div>
  </div>
</section>

<!-- Cloudflare Turnstile Script -->
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<script>
  function onContactTurnstileSuccess(token) {
    const submitBtn = document.getElementById('contactSubmitBtn');
    if (submitBtn) {
      submitBtn.disabled = false;
      submitBtn.style.opacity = '1';
    }
    const tokenInput = document.createElement('input');
    tokenInput.type = 'hidden';
    tokenInput.name = 'cf-turnstile-response';
    tokenInput.value = token;
    document.getElementById('contactForm').appendChild(tokenInput);
  }

  document.addEventListener('turbo:load', function() {
    // Set form timestamp
    const timestampField = document.getElementById('contactFormTimestamp');
    if (timestampField) {
      timestampField.value = Math.floor(Date.now() / 1000);
    }

    const contactForm = document.getElementById('contactForm');
    if (contactForm) {
      contactForm.addEventListener('submit', async function(e) {
        e.preventDefault();

        const formData = new FormData(contactForm);
        const submitBtn = document.getElementById('contactSubmitBtn');
        const originalText = submitBtn.value;

        submitBtn.disabled = true;
        submitBtn.value = 'Sending...';

        const csrfToken = document.querySelector('meta[name="csrf-token"]').getAttribute('content');

        try {
          const response = await fetch(contactForm.action, {
            method: 'POST',
            headers: {
              'X-CSRF-Token': csrfToken
            },
            body: formData
          });

          const result = await response.json();

          if (result.success) {
            // Hide form and show success message
            document.getElementById('contactFormContent').style.display = 'none';
            document.getElementById('contactSuccessMessage').style.display = 'block';
          } else {
            alert('Error: ' + (result.errors ? result.errors.join(', ') : 'Something went wrong'));
            submitBtn.value = originalText;
            submitBtn.disabled = false;
          }
        } catch (error) {
          alert('Error submitting form. Please try again.');
          submitBtn.value = originalText;
          submitBtn.disabled = false;
        }
      });
    }
  });
</script>

