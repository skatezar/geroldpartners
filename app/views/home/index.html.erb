<!-- CV Upload Section -->
<section id="cv-upload" class="cv-upload section-animate">
  <div class="container">
    <h2>Join Our Network</h2>
    <p>Upload your CV to be considered for current and future opportunities</p>
    <%= form_with url: "#", multipart: true, class: "cv-form" do |f| %>
      <div class="form-group">
        <%= f.label :name, "Full Name" %>
        <%= f.text_field :name, required: true %>
      </div>
      <div class="form-group">
        <%= f.label :email, "Email" %>
        <%= f.email_field :email, required: true %>
      </div>
      <div class="form-group">
        <%= f.label :phone, "Phone" %>
        <%= f.telephone_field :phone %>
      </div>
      <div class="form-group">
        <%= f.label :cv, "Upload CV (PDF)" %>
        <%= f.file_field :cv, accept: ".pdf", required: true %>
      </div>
      <%= f.submit "Submit CV", class: "btn-primary" %>
    <% end %>
  </div>
</section>

<!-- Contact Form -->
<section id="contact" class="contact section-animate">
  <div class="container">
    <h2>Get In Touch</h2>
    <p>Whether you're seeking exceptional talent or exploring new opportunities, we'd love to hear from you.</p>
    <%= form_with url: "#", class: "contact-form" do |f| %>
      <div class="form-row">
        <div class="form-group">
          <%= f.label :name, "Name" %>
          <%= f.text_field :name, required: true %>
        </div>
        <div class="form-group">
          <%= f.label :email, "Email" %>
          <%= f.email_field :email, required: true %>
        </div>
      </div>
      <div class="form-group">
        <%= f.label :subject, "Subject" %>
        <%= f.text_field :subject, required: true %>
      </div>
      <div class="form-group">
        <%= f.label :message, "Message" %>
        <%= f.text_area :message, rows: 6, required: true %>
      </div>
      <%= f.submit "Send Message", class: "btn-primary" %>
    <% end %>
  </div>
</section>

