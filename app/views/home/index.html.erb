        <%= f.email_field :email, required: true, class: "modal-input" %>
      </div>

      <div class="form-group">
        <%= f.label :linkedin_url, "LinkedIn URL (Optional)" %>
        <%= f.text_field :linkedin_url, placeholder: "https://linkedin.com/in/yourprofile", class: "modal-input" %>
