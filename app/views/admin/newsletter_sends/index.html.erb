<div class="ns-container">

  <div class="ns-header">
    <h1>Send Newsletter</h1>
  </div>

  <% if alert.present? %>
    <div class="ns-flash error"><%= alert %></div>
  <% end %>
  <% if notice.present? %>
    <div class="ns-flash success"><%= notice %></div>
  <% end %>

  <!-- ── COMPOSE FORM ── -->
  <%= form_tag admin_newsletter_sends_path, method: :post, id: "compose-form" do %>

    <!-- Step 1: Template -->
    <div class="ns-card">
      <div class="ns-card-header">1 — Choose template</div>
      <div class="template-grid">
        <label class="template-option" id="tpl-blank">
          <input type="radio" name="template_name" value="blank" checked onchange="selectTemplate(this)">
          <div class="tpl-inner">
            <div class="tpl-label">Blank</div>
            <div class="tpl-desc">Clean branded shell — write your own content</div>
          </div>
        </label>
        <label class="template-option" id="tpl-blog_credit_md_2026">
          <input type="radio" name="template_name" value="blog_credit_md_2026" onchange="selectTemplate(this)">
          <div class="tpl-inner">
            <div class="tpl-label">Blog: Senior MD Comp 2026</div>
            <div class="tpl-desc">Pre-filled with the credit MD compensation report</div>
          </div>
        </label>
      </div>
    </div>

    <!-- Step 2: Subject -->
    <div class="ns-card">
      <div class="ns-card-header">2 — Subject line</div>
      <input type="text" name="subject" id="subject-field" placeholder="e.g. What a Senior MD Earns at a Private Credit Fund — 2026"
             class="ns-input" required>
    </div>

    <!-- Step 3: Recipients -->
    <div class="ns-card">
      <div class="ns-card-header">3 — Recipients</div>

      <div class="recipients-area">
        <div id="recipient-tags" class="recipient-tags"></div>
        <button type="button" class="btn-outline" onclick="openModal()">+ Add recipients</button>
        <input type="hidden" name="recipient_emails" id="recipient-emails-input">
        <p class="ns-hint" id="recipient-count-hint">No recipients added yet.</p>
      </div>
    </div>

    <!-- Send -->
    <div class="ns-actions">
      <button type="submit" class="btn-primary">Create campaign →</button>
      <a href="<%= admin_newsletter_subscriptions_path %>" class="btn-ghost">← Subscriptions</a>
    </div>

  <% end %>

  <!-- ── PAST CAMPAIGNS ── -->
  <% if NewsletterSend.any? %>
    <div class="ns-card" style="margin-top:40px;">
      <div class="ns-card-header">Past campaigns</div>
      <table class="ns-table">
        <thead>
          <tr>
            <th>Subject</th>
            <th>Template</th>
            <th>Status</th>
            <th>Recipients</th>
            <th>Sent</th>
            <th>Created</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% NewsletterSend.recent.each do |s| %>
            <tr>
              <td><%= s.subject %></td>
              <td><span class="tpl-chip"><%= s.template_name&.gsub("_", " ") %></span></td>
              <td><span class="status-chip status-<%= s.status %>"><%= s.status %></span></td>
              <td><%= s.total_recipients %></td>
              <td><%= s.sent_count %> / <%= s.total_recipients %></td>
              <td><%= s.created_at.strftime("%b %d, %Y") %></td>
              <td><%= link_to "View", admin_newsletter_send_path(s), class: "btn-sm" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>

</div>

<!-- ── RECIPIENTS MODAL ── -->
<div id="recipients-modal" class="modal-backdrop" style="display:none;" onclick="closeModalOnBackdrop(event)">
  <div class="modal-box">
    <div class="modal-header">
      <h2>Add recipients</h2>
      <button type="button" class="modal-close" onclick="closeModal()">✕</button>
    </div>

    <div class="modal-body">
      <!-- Quick-add from confirmed subscribers -->
      <div class="modal-section">
        <div class="modal-section-label">Your confirmed subscribers</div>
        <div class="subscriber-list">
          <% if @subscribers.any? %>
            <button type="button" class="btn-outline btn-sm" onclick="addAllSubscribers()" style="margin-bottom:10px;">Add all (<%= @subscribers.size %>)</button>
            <div class="subscriber-scroll">
              <% @subscribers.each do |email| %>
                <div class="subscriber-row" id="sub-<%= email.gsub('@','_').gsub('.','_') %>">
                  <span class="sub-email"><%= email %></span>
                  <button type="button" class="btn-add-sub" onclick="addSubscriber('<%= email %>')">Add</button>
                </div>
              <% end %>
            </div>
          <% else %>
            <p class="ns-hint">No confirmed subscribers yet.</p>
          <% end %>
        </div>
      </div>

      <!-- Manual email entry -->
      <div class="modal-section">
        <div class="modal-section-label">Or paste / type emails</div>
        <textarea id="manual-emails" class="ns-textarea" placeholder="Separate by comma, space, or newline&#10;e.g. alice@example.com, bob@example.com" rows="4"></textarea>
        <button type="button" class="btn-outline btn-sm" onclick="addManualEmails()" style="margin-top:8px;">Add emails</button>
      </div>
    </div>

    <div class="modal-footer">
      <span id="modal-count">0 recipients selected</span>
      <button type="button" class="btn-primary" onclick="closeModal()">Done</button>
    </div>
  </div>
</div>

<style>
  *, *::before, *::after { box-sizing: border-box; }

  .ns-container {
    max-width: 860px;
    margin: 40px auto;
    padding: 0 20px;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif;
  }

  .ns-header { margin-bottom: 32px; padding-bottom: 20px; border-bottom: 2px solid #000; }
  .ns-header h1 { margin: 0; font-size: 2.4rem; font-weight: 300; letter-spacing: 1px; }

  .ns-flash { padding: 12px 20px; border-radius: 4px; margin-bottom: 20px; font-size: 0.95rem; }
  .ns-flash.success { background: #d4edda; color: #155724; border: 1px solid #c3e6cb; }
  .ns-flash.error   { background: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; }

  .ns-card {
    background: #fff;
    border: 1px solid #e0e0e0;
    margin-bottom: 20px;
    overflow: hidden;
  }

  .ns-card-header {
    background: #000;
    color: #fff;
    padding: 12px 20px;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  /* template grid */
  .template-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    padding: 20px;
  }

  .template-option {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 16px;
    border: 2px solid #e0e0e0;
    cursor: pointer;
    transition: border-color 0.2s;
  }

  .template-option:has(input:checked) { border-color: #000; }
  .template-option input[type="radio"] { margin-top: 3px; flex-shrink: 0; }
  .tpl-label { font-weight: 600; font-size: 0.95rem; margin-bottom: 4px; }
  .tpl-desc  { font-size: 0.82rem; color: #666; line-height: 1.4; }

  .ns-input {
    display: block;
    width: 100%;
    padding: 12px 16px;
    border: none;
    border-top: 1px solid #e0e0e0;
    font-size: 1rem;
    font-family: inherit;
    outline: none;
  }

  .ns-input:focus { background: #fafafa; }

  /* recipients */
  .recipients-area { padding: 20px; }

  .recipient-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 12px;
  }

  .recipient-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #f0f0f0;
    border: 1px solid #ddd;
    padding: 4px 10px;
    border-radius: 20px;
    font-size: 0.82rem;
  }

  .tag-remove {
    cursor: pointer;
    color: #999;
    font-size: 0.75rem;
    background: none;
    border: none;
    padding: 0;
    line-height: 1;
  }

  .tag-remove:hover { color: #c00; }

  .ns-hint { font-size: 0.82rem; color: #888; margin: 8px 0 0; }

  /* actions */
  .ns-actions { display: flex; gap: 12px; align-items: center; margin-top: 8px; }

  /* buttons */
  .btn-primary {
    padding: 12px 24px;
    background: #000;
    color: #fff;
    border: none;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.5px;
    cursor: pointer;
    transition: background 0.2s;
  }
  .btn-primary:hover { background: #333; }

  .btn-outline {
    padding: 9px 18px;
    background: #fff;
    color: #000;
    border: 1px solid #000;
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.2s;
  }
  .btn-outline:hover { background: #f0f0f0; }

  .btn-ghost {
    padding: 12px 24px;
    background: none;
    color: #666;
    border: none;
    font-size: 0.9rem;
    text-decoration: none;
    cursor: pointer;
  }
  .btn-ghost:hover { color: #000; }

  .btn-sm { padding: 6px 14px; font-size: 0.8rem; }

  /* table */
  .ns-table { width: 100%; border-collapse: collapse; }
  .ns-table thead { background: #000; color: #fff; }
  .ns-table th, .ns-table td { padding: 12px 16px; text-align: left; font-size: 0.875rem; }
  .ns-table th { font-weight: 500; text-transform: uppercase; font-size: 0.78rem; letter-spacing: 0.8px; }
  .ns-table tbody tr { border-bottom: 1px solid #eee; }
  .ns-table tbody tr:hover { background: #fafafa; }

  .status-chip {
    padding: 3px 12px;
    border-radius: 20px;
    font-size: 0.78rem;
    font-weight: 600;
    display: inline-block;
    text-transform: capitalize;
  }
  .status-draft     { background: #e9ecef; color: #495057; }
  .status-sending   { background: #cce5ff; color: #004085; }
  .status-completed { background: #d4edda; color: #155724; }
  .status-failed    { background: #f8d7da; color: #721c24; }

  .tpl-chip {
    font-size: 0.78rem;
    color: #555;
    text-transform: capitalize;
  }

  /* modal */
  .modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.55);
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .modal-box {
    background: #fff;
    width: 560px;
    max-width: 95vw;
    max-height: 90vh;
    display: flex;
    flex-direction: column;
    box-shadow: 0 20px 60px rgba(0,0,0,0.3);
  }

  .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 24px;
    border-bottom: 1px solid #e0e0e0;
  }

  .modal-header h2 { margin: 0; font-size: 1.2rem; font-weight: 600; }

  .modal-close {
    background: none;
    border: none;
    font-size: 1.1rem;
    cursor: pointer;
    color: #666;
    padding: 4px 8px;
  }
  .modal-close:hover { color: #000; }

  .modal-body { overflow-y: auto; padding: 20px 24px; flex: 1; }

  .modal-section { margin-bottom: 24px; }
  .modal-section-label {
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: #888;
    margin-bottom: 10px;
  }

  .subscriber-scroll {
    max-height: 200px;
    overflow-y: auto;
    border: 1px solid #e0e0e0;
  }

  .subscriber-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 12px;
    border-bottom: 1px solid #f0f0f0;
    font-size: 0.875rem;
  }

  .subscriber-row:last-child { border-bottom: none; }
  .subscriber-row.added { background: #f0fff4; }
  .sub-email { color: #333; }

  .btn-add-sub {
    font-size: 0.75rem;
    padding: 3px 10px;
    background: #000;
    color: #fff;
    border: none;
    cursor: pointer;
    border-radius: 2px;
    white-space: nowrap;
  }

  .btn-add-sub.added-state {
    background: #28a745;
    cursor: default;
  }

  .ns-textarea {
    width: 100%;
    padding: 10px 14px;
    border: 1px solid #ccc;
    font-size: 0.9rem;
    font-family: inherit;
    outline: none;
    resize: vertical;
  }
  .ns-textarea:focus { border-color: #000; }

  .modal-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 24px;
    border-top: 1px solid #e0e0e0;
    font-size: 0.875rem;
    color: #555;
  }
</style>

<script>
  let recipients = new Set();

  const SUBJECT_DEFAULTS = {
    "blank": "",
    "blog_credit_md_2026": "What a Senior MD Earns at a Private Credit Fund in London — 2026"
  };

  function selectTemplate(radio) {
    const subjectField = document.getElementById("subject-field");
    const def = SUBJECT_DEFAULTS[radio.value] || "";
    if (def) subjectField.value = def;
  }

  function openModal() {
    document.getElementById("recipients-modal").style.display = "flex";
    syncModalButtons();
  }

  function closeModal() {
    document.getElementById("recipients-modal").style.display = "none";
    renderTags();
  }

  function closeModalOnBackdrop(e) {
    if (e.target === document.getElementById("recipients-modal")) closeModal();
  }

  function syncModalButtons() {
    document.querySelectorAll(".subscriber-row").forEach(row => {
      const emailSpan = row.querySelector(".sub-email");
      const btn = row.querySelector(".btn-add-sub");
      if (recipients.has(emailSpan.textContent.trim())) {
        row.classList.add("added");
        btn.textContent = "Added ✓";
        btn.classList.add("added-state");
        btn.disabled = true;
      } else {
        row.classList.remove("added");
        btn.textContent = "Add";
        btn.classList.remove("added-state");
        btn.disabled = false;
      }
    });
    updateModalCount();
  }

  function addSubscriber(email) {
    recipients.add(email.toLowerCase().trim());
    syncModalButtons();
  }

  function addAllSubscribers() {
    document.querySelectorAll(".sub-email").forEach(el => {
      recipients.add(el.textContent.trim().toLowerCase());
    });
    syncModalButtons();
  }

  function addManualEmails() {
    const raw = document.getElementById("manual-emails").value;
    const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    raw.split(/[\s,;\n]+/).map(e => e.trim().toLowerCase()).filter(e => EMAIL_RE.test(e)).forEach(e => recipients.add(e));
    document.getElementById("manual-emails").value = "";
    syncModalButtons();
  }

  function removeRecipient(email) {
    recipients.delete(email);
    renderTags();
    syncModalButtons();
  }

  function renderTags() {
    const container = document.getElementById("recipient-tags");
    const hint = document.getElementById("recipient-count-hint");
    const input = document.getElementById("recipient-emails-input");

    container.innerHTML = "";
    recipients.forEach(email => {
      const tag = document.createElement("span");
      tag.className = "recipient-tag";
      tag.innerHTML = `${email} <button type="button" class="tag-remove" onclick="removeRecipient('${email.replace(/'/g, "\\'")}')">✕</button>`;
      container.appendChild(tag);
    });

    const count = recipients.size;
    hint.textContent = count === 0 ? "No recipients added yet." : `${count} recipient${count === 1 ? "" : "s"} added.`;
    input.value = Array.from(recipients).join(",");
  }

  function updateModalCount() {
    document.getElementById("modal-count").textContent =
      `${recipients.size} recipient${recipients.size === 1 ? "" : "s"} selected`;
  }
</script>
