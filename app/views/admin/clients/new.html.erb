<div class="admin-container">
  <div class="admin-header">
    <h1>New Client</h1>
    <%= link_to "← Back to Clients", admin_clients_path, class: "btn-secondary" %>
  </div>
  <%= render "form", client: @client %>
</div>

<style>
  .admin-container { max-width: 1200px; margin: 40px auto; padding: 0 20px; font-family: 'Garamond', serif; }
  .admin-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; padding-bottom: 20px; border-bottom: 2px solid #000; }
  .admin-header h1 { margin: 0; font-size: 2.5rem; }
  .btn-secondary { padding: 8px 18px; background: #eee; color: #333; text-decoration: none; border-radius: 6px; }
</style>
