<div class="admin-container">
  <div class="admin-header">
    <h1>Manage Mandates</h1>
    <%= link_to "New Mandate", new_admin_mandate_path, class: "btn-primary" %>
  </div>

  <% if @mandates.any? %>
    <div class="mandates-table">
      <table>
        <thead>
          <tr>
            <th>Title</th>
            <th>Location</th>
            <th>Firm</th>
            <th>Status</th>
            <th>Applications</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @mandates.each do |mandate| %>
            <tr>
              <td><%= mandate.title %></td>
              <td><%= mandate.location %></td>
              <td><%= mandate.firm_name.present? ? mandate.firm_name : "Confidential" %></td>
              <td>
                <span class="status-badge <%= mandate.active? ? 'active' : 'inactive' %>">
                  <%= mandate.active? ? 'Active' : 'Inactive' %>
                </span>
              </td>
              <td><%= mandate.job_applications.count %></td>
              <td class="actions">
                <%= link_to "View More", admin_mandate_path(mandate), class: "btn-small btn-view" %>
                <%= link_to "Edit", edit_admin_mandate_path(mandate), class: "btn-small" %>
                <%= button_to "Delete", admin_mandate_path(mandate), method: :delete,
                    data: { confirm: "Are you sure?" }, class: "btn-small btn-danger" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="no-data">No mandates yet. Create your first mandate to get started.</p>
  <% end %>
</div>

<style>
  .admin-container {
    max-width: 1200px;
    margin: 40px auto;
    padding: 0 20px;
    font-family: 'Garamond', serif;
  }

  .admin-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid #000;
  }

  .admin-header h1 {
    margin: 0;
    font-size: 2.5rem;
  }

  .mandates-table {
    background: white;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  }

  table {
    width: 100%;
    border-collapse: collapse;
  }

  thead {
    background: #000;
    color: white;
  }

  th, td {
    padding: 15px;
    text-align: left;
  }

  th {
    font-weight: 600;
    text-transform: uppercase;
    font-size: 0.9rem;
    letter-spacing: 0.5px;
  }

  tbody tr {
    border-bottom: 1px solid #eee;
    transition: background 0.2s;
  }

  tbody tr:hover {
    background: #f8f8f8;
  }

  .status-badge {
    padding: 5px 12px;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 600;
  }

  .status-badge.active {
    background: #d4edda;
    color: #155724;
  }

  .status-badge.inactive {
    background: #f8d7da;
    color: #721c24;
  }

  .actions {
    display: flex;
    gap: 10px;
  }

  .btn-small {
    padding: 6px 16px;
    font-size: 0.9rem;
    background: #333;
    color: white;
    text-decoration: none;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    transition: background 0.2s;
  }

  .btn-small:hover {
    background: #000;
  }

  .btn-view {
    background: #007bff;
  }

  .btn-view:hover {
    background: #0056b3;
  }

  .btn-danger {
    background: #dc3545;
  }

  .btn-danger:hover {
    background: #c82333;
  }

  .no-data {
    text-align: center;
    padding: 60px 20px;
    color: #666;
    font-size: 1.2rem;
  }
</style>
