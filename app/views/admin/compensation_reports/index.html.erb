<div class="admin-container">
  <div class="admin-header">
    <h1>Manage Compensation Reports</h1>
    <%= link_to "New Compensation Report", new_admin_compensation_report_path, class: "btn-primary" %>
  </div>

  <% if @compensation_reports.any? %>
    <div class="reports-table">
      <table>
        <thead>
          <tr>
            <th>Name</th>
            <th>Location</th>
            <th>PDF</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @compensation_reports.each do |report| %>
            <tr>
              <td><%= report.name %></td>
              <td><%= report.location %></td>
              <td>
                <% if report.pdf.attached? %>
                  <%= link_to "View PDF", rails_blob_path(report.pdf, disposition: "attachment"), class: "pdf-link", target: "_blank" %>
                <% else %>
                  <span class="no-pdf">No PDF</span>
                <% end %>
              </td>
              <td class="actions">
                <button class="btn-small btn-copy" onclick="copyReportLink('<%= compensation_report_url(report) %>', this)">Copy Link</button>
                <%= link_to "Edit", edit_admin_compensation_report_path(report), class: "btn-small" %>
                <%= button_to "Delete", admin_compensation_report_path(report), method: :delete,
                    data: { confirm: "Are you sure?" }, class: "btn-small btn-danger" %>
              </td>
            </tr>
            <% if report.report_downloads.any? %>
              <tr class="downloads-row">
                <td colspan="4" style="padding: 0;">
                  <div class="downloads-panel">
                    <div class="downloads-panel-header">
                      <%= report.report_downloads.size %> download<%= report.report_downloads.size == 1 ? "" : "s" %>
                    </div>
                    <table class="downloads-table">
                      <thead>
                        <tr>
                          <th>Name</th>
                          <th>Email</th>
                          <th>Newsletter</th>
                          <th>Date</th>
                        </tr>
                      </thead>
                      <tbody>
                        <% report.report_downloads.order(created_at: :desc).each do |dl| %>
                          <tr>
                            <td><%= dl.name %></td>
                            <td><%= dl.email %></td>
                            <td>
                              <% if @subscriber_emails.include?(dl.email.to_s.downcase) %>
                                <span class="badge-yes">Subscribed</span>
                              <% else %>
                                <span class="badge-no">No</span>
                              <% end %>
                            </td>
                            <td><%= dl.created_at.strftime("%-d %b %Y") %></td>
                          </tr>
                        <% end %>
                      </tbody>
                    </table>
                  </div>
                </td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="no-data">No compensation reports yet. Create your first report to get started.</p>
  <% end %>
</div>

<style>
  .admin-container {
    max-width: 1200px;
    margin: 40px auto;
    padding: 0 20px;
    font-family: 'Garamond', serif;
  }

  .admin-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid #000;
  }

  .admin-header h1 {
    margin: 0;
    font-size: 2.5rem;
  }

  .reports-table {
    background: white;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  }

  table {
    width: 100%;
    border-collapse: collapse;
  }

  thead {
    background: #000;
    color: white;
  }

  th, td {
    padding: 15px;
    text-align: left;
  }

  th {
    font-weight: 600;
    text-transform: uppercase;
    font-size: 0.9rem;
    letter-spacing: 0.5px;
  }

  tbody tr {
    border-bottom: 1px solid #eee;
    transition: background 0.2s;
  }

  tbody tr:hover {
    background: #f8f8f8;
  }

  .pdf-link {
    color: #007bff;
    text-decoration: none;
  }

  .pdf-link:hover {
    text-decoration: underline;
  }

  .no-pdf {
    color: #999;
    font-style: italic;
  }

  .actions {
    display: flex;
    gap: 10px;
  }

  .btn-small {
    padding: 6px 16px;
    font-size: 0.9rem;
    background: #333;
    color: white;
    text-decoration: none;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    transition: background 0.2s;
  }

  .btn-small:hover {
    background: #000;
  }

  .btn-danger {
    background: #dc3545;
  }

  .btn-danger:hover {
    background: #c82333;
  }

  .no-data {
    text-align: center;
    padding: 60px 20px;
    color: #666;
    font-size: 1.2rem;
  }

  .btn-copy {
    background: #555;
  }

  .btn-copy:hover {
    background: #333;
  }

  .btn-copy.copied {
    background: #28a745;
  }

  .downloads-row td { padding: 0 !important; background: #f4f4f4; }
  .downloads-row:hover td { background: #f4f4f4; }
  .downloads-panel { padding: 12px 20px 16px; }
  .downloads-panel-header { font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: #888; margin-bottom: 8px; }
  .downloads-table { width: 100%; border-collapse: collapse; background: white; border-radius: 6px; overflow: hidden; box-shadow: 0 1px 4px rgba(0,0,0,0.08); }
  .downloads-table thead { background: #333; }
  .downloads-table th { padding: 8px 12px; font-size: 0.78rem; color: white; text-transform: uppercase; letter-spacing: 0.4px; font-weight: 600; }
  .downloads-table td { padding: 8px 12px; font-size: 0.9rem; border-bottom: 1px solid #f0f0f0; color: #333; }
  .downloads-table tbody tr:last-child td { border-bottom: none; }
  .badge-yes { background: #d4edda; color: #155724; padding: 2px 8px; border-radius: 10px; font-size: 0.78rem; font-weight: 600; }
  .badge-no  { background: #f0f0f0; color: #999; padding: 2px 8px; border-radius: 10px; font-size: 0.78rem; }
</style>

<script>
  function copyReportLink(url, btn) {
    navigator.clipboard.writeText(url).then(() => {
      btn.textContent = 'Copied!';
      btn.classList.add('copied');
      setTimeout(() => {
        btn.textContent = 'Copy Link';
        btn.classList.remove('copied');
      }, 2000);
    });
  }
</script>
