<div class="admin-container">
  <div class="admin-header">
    <h1>Manage Compensation Reports</h1>
    <%= link_to "New Compensation Report", new_admin_compensation_report_path, class: "btn-primary" %>
  </div>

  <% if @compensation_reports.any? %>
    <div class="reports-table">
      <table>
        <thead>
          <tr>
            <th>Name</th>
            <th>Location</th>
            <th>PDF</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @compensation_reports.each do |report| %>
            <tr>
              <td><%= report.name %></td>
              <td><%= report.location %></td>
              <td>
                <% if report.pdf.attached? %>
                  <%= link_to "View PDF", rails_blob_path(report.pdf, disposition: "attachment"), class: "pdf-link", target: "_blank" %>
                <% else %>
                  <span class="no-pdf">No PDF</span>
                <% end %>
              </td>
              <td class="actions">
                <%= link_to "Edit", edit_admin_compensation_report_path(report), class: "btn-small" %>
                <%= button_to "Delete", admin_compensation_report_path(report), method: :delete,
                    data: { confirm: "Are you sure?" }, class: "btn-small btn-danger" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="no-data">No compensation reports yet. Create your first report to get started.</p>
  <% end %>
</div>

<style>
  .admin-container {
    max-width: 1200px;
    margin: 40px auto;
    padding: 0 20px;
    font-family: 'Garamond', serif;
  }

  .admin-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid #000;
  }

  .admin-header h1 {
    margin: 0;
    font-size: 2.5rem;
  }

  .reports-table {
    background: white;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  }

  table {
    width: 100%;
    border-collapse: collapse;
  }

  thead {
    background: #000;
    color: white;
  }

  th, td {
    padding: 15px;
    text-align: left;
  }

  th {
    font-weight: 600;
    text-transform: uppercase;
    font-size: 0.9rem;
    letter-spacing: 0.5px;
  }

  tbody tr {
    border-bottom: 1px solid #eee;
    transition: background 0.2s;
  }

  tbody tr:hover {
    background: #f8f8f8;
  }

  .pdf-link {
    color: #007bff;
    text-decoration: none;
  }

  .pdf-link:hover {
    text-decoration: underline;
  }

  .no-pdf {
    color: #999;
    font-style: italic;
  }

  .actions {
    display: flex;
    gap: 10px;
  }

  .btn-small {
    padding: 6px 16px;
    font-size: 0.9rem;
    background: #333;
    color: white;
    text-decoration: none;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    transition: background 0.2s;
  }

  .btn-small:hover {
    background: #000;
  }

  .btn-danger {
    background: #dc3545;
  }

  .btn-danger:hover {
    background: #c82333;
  }

  .no-data {
    text-align: center;
    padding: 60px 20px;
    color: #666;
    font-size: 1.2rem;
  }
</style>
